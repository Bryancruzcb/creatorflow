{
  "name": "creatorflow-preflight",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "assets:derive": "node scripts/derive-glb-assets.mjs",
    "assets:ships": "node scripts/fetch-polyhaven-ships.mjs",
    "assets:stress": "node scripts/generate-stress-fixtures.mjs",
    "fixtures:motion": "node scripts/extract-motion-fixtures.mjs",
    "schema:check": "node scripts/check-manifest-schema.mjs",
    "schema:validators": "node scripts/compile-manifest-validators.mjs",
    "build": "npm run schema:check && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "npm run schema:check && tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "harness": "vite --config vite.harness.config.ts",
    "test:audit": "playwright test --config playwright.audit.config.ts",
    "inspect:motion": "node scripts/inspect-motion.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "framer-motion": "12.43.0",
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@gltf-transform/cli": "^4.4.2",
    "@playwright/test": "^1.62.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "^30.0.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  }
}
